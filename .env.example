# Database (infra/docker-compose.yml)
POSTGRES_USER=wx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wx
DATABASE_URL=postgres://wx:change-me@localhost:5432/wx
# pipeline DB tests: a server where this user may CREATE DATABASE (tests create and drop their own)
TEST_DATABASE_URL=postgres://wx:change-me@localhost:5432/wx

# Pipeline
# Optional; default: aervuna-pipeline/<version> (+https://github.com/atesbazi/aervuna)
METAR_USER_AGENT=
ECMWF_OPEN_DATA_SOURCE=ecmwf

# Providers (API server only — never in the mobile app)
OPEN_METEO_API_KEY=
METEOBLUE_API_KEY=
